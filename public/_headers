# Cloudflare static asset headers: https://developers.cloudflare.com/workers/static-assets/headers/

# Always check for a new service worker, so users get updates
/service-worker.js
  Cache-Control: no-cache

# Built files have a content hash in their name and never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
